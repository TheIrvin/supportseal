# --- Application ---------------------------------------------------------
# Public origin of this deployment (metadataBase, widget embed URLs, emails).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Central brand name shown in the UI (Initial.md §58: keep it configurable).
NEXT_PUBLIC_APP_NAME=SupportSeal

# --- Database ------------------------------------------------------------
# Postgres connection string. Leave empty in development to use a local
# file-backed PGlite database at .dev-data/pglite.db (migrate it with
# `npm run db:dev`). Production requires a real Postgres URL, e.g.
# Attachment storage directory (default .dev-data/uploads; mount a volume in
# production — see docs/self-hosting.md).
# STORAGE_DIR=postgresql://postgres:postgres@localhost:5432/supportseal
DATABASE_URL=

# --- Auth ----------------------------------------------------------------
# Session signing secret (required in production): openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Hosting mode ---------------------------------------------------------
# Leave unset/empty for self-hosted (single Workspace, no billing).
# Set to 1 only for the managed multi-tenant SaaS deployment.
# HOSTED_MODE=

# --- Email -----------------------------------------------------------------
# Inbound webhook shared secret (also accepted as ?secret= on the URL for
# providers that cannot set headers). Use a URL-safe value (openssl rand
# -hex 32) because Postmark's webhook URL embeds it as Basic-Auth userinfo.
INBOUND_WEBHOOK_SECRET=
# Domain that receives forwarded support mail (product_xxx@INBOUND_EMAIL_DOMAIN).
INBOUND_EMAIL_DOMAIN=inbound.localhost
# Outbound: Postmark API (hosted provider) takes precedence over SMTP.
# Server token from your Postmark server's API Tokens tab — never commit it.
# POSTMARK_SERVER_TOKEN=
# Optional Postmark message stream (default "outbound").
# POSTMARK_MESSAGE_STREAM=outbound
# Outbound SMTP URL (smtps://user:pass@smtp.provider:465). Without Postmark or
# SMTP configured, agent replies are recorded but not delivered (dev mode).
SMTP_URL=
# Local part of the managed sender ("{Product} Support" <OUTBOUND_EMAIL_LOCAL@INBOUND_EMAIL_DOMAIN>).
OUTBOUND_EMAIL_LOCAL=no-reply

# --- Hosted billing (hosted mode only; self-hosting never needs these) ----
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRO_PRICE_ID=
# Free plan included conversations per month (default 100) and grace days (default 14):
# FREE_TIER_CONVERSATION_LIMIT=100
# USAGE_GRACE_DAYS=14

# --- Analytics (optional, off unless both are set) -------------------------
# Umami on the public marketing pages only. Nothing loads (and nothing is
# sent from self-hosted installs) unless both values are configured.
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://analytics.example.com/script.js
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Inbound email webhook (filled in the inbound email slice) -----------
# INBOUND_WEBHOOK_SECRET=
